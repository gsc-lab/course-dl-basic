# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# 데이터셋과 실행 결과물은 커밋하지 않는다
data/*
!data/.gitkeep
outputs/*
!outputs/.gitkeep
*.pt
*.pth

# 자유롭게 실험하는 폴더: 폴더만 유지하고 안의 파일은 커밋하지 않는다
scratch/*
!scratch/.gitkeep

# 환경, OS, 에디터
.env
.DS_Store
.vscode/
.idea/
